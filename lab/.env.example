# ============================================================================
#  Copier ce fichier en .env puis remplacer les mots de passe et la clé.
#  Le fichier .env est exclu de Git (.gitignore) : ne JAMAIS le publier.
# ============================================================================

# Version de la suite Elastic (Elasticsearch et Kibana doivent être identiques)
STACK_VERSION=8.19.21

CLUSTER_NAME=soc-medisoft

# Mot de passe du super-administrateur "elastic" (au moins 12 caractères)
ELASTIC_PASSWORD=ChangeMoi_Elastic_2026

# Mot de passe du compte technique "kibana_system" (au moins 12 caractères)
KIBANA_PASSWORD=ChangeMoi_Kibana_2026

# Clé de chiffrement Kibana : 32 caractères minimum, aléatoire
# Générer avec : openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=remplacer_par_le_resultat_de_openssl_rand_hex_32

ES_PORT=9200
KIBANA_PORT=5601

# Ressources (adaptées à un PC de 8 Go de RAM)
ES_HEAP=1g
ES_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=1536m
